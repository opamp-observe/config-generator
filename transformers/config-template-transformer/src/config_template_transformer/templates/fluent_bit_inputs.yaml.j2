pipeline:
{% if plugins %}
  inputs:
{% for plugin in plugins %}
    - name: {{ plugin.name | tojson }}
      path: {{ plugin.path | tojson }}
{% for property_name, property_value in plugin.items() %}
{% if property_name not in ["name", "path"] %}
      {{ property_name }}: {{ property_value | tojson }}
{% endif %}
{% endfor %}
{% endfor %}
{% else %}
  inputs: []
{% endif %}
