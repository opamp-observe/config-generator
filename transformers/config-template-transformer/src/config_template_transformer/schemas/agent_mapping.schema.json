{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Copyright 2026 opamp.info; licensed under the Apache License, Version 2.0.",
  "title": "Observability agent detector mapping",
  "description": "Maps detector output to one agent-specific versioned template and plugin context.",
  "type": "object",
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "_comment": {
      "type": "string",
      "description": "Source license attribution retained in JSON-compatible form."
    },
    "api_version": {
      "const": "opamp.info/v1alpha1",
      "description": "Version of the agent-mapping contract."
    },
    "kind": {
      "const": "ObservabilityAgentMapping",
      "description": "Resource kind understood by the mapping catalogue."
    },
    "metadata": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": ["detector", "agent", "output", "render", "rules"],
      "properties": {
        "detector": {
          "type": "object",
          "required": ["name", "version_constraint"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version_constraint": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "agent": {
          "type": "object",
          "required": ["type", "minimum_version"],
          "properties": {
            "type": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
            "minimum_version": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "output": {
          "type": "object",
          "required": ["path", "include_path"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "include_path": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "render": {
          "type": "object",
          "required": ["engine", "template", "metadata_file", "version", "template_api_version", "context_name"],
          "properties": {
            "engine": {"const": "jinja2"},
            "template": {"type": "string", "minLength": 1},
            "metadata_file": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "template_api_version": {"type": "string", "minLength": 1},
            "context_name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
          },
          "additionalProperties": false
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "for_each", "values"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "for_each": {"type": "string", "pattern": "^\\$"},
              "path_from": {"type": "string", "pattern": "^\\$"},
              "path_match": {"type": "string", "minLength": 1},
              "fields_from": {
                "type": "object",
                "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
                "additionalProperties": {"type": "string", "pattern": "^\\$"}
              },
              "source_format": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
              },
              "values": {
                "type": "object",
                "minProperties": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
