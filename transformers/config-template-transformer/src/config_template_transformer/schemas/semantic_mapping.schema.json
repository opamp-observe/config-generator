{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Copyright 2026 opamp.info; licensed under the Apache License, Version 2.0.",
  "title": "OpenTelemetry semantic payload mapping",
  "type": "object",
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "_comment": {"type": "string"},
    "api_version": {"const": "opamp.info/v1alpha1"},
    "kind": {"const": "OpenTelemetrySemanticMapping"},
    "metadata": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": ["detector", "source", "semantic_conventions", "parse", "payload"],
      "properties": {
        "detector": {
          "type": "object",
          "required": ["name", "version_constraint"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version_constraint": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "source": {
          "type": "object",
          "required": ["formats"],
          "properties": {
            "formats": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "path_regex": {"type": "string", "minLength": 1},
            "priority": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "semantic_conventions": {
          "type": "object",
          "required": ["version", "signal"],
          "properties": {
            "version": {"type": "string", "minLength": 1},
            "signal": {"const": "logs"}
          },
          "additionalProperties": false
        },
        "parse": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {"enum": ["regex", "csv"]},
            "expression": {"type": "string", "minLength": 1},
            "columns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "types": {"type": "object", "additionalProperties": {"enum": ["integer", "float", "string"]}},
            "time_field": {"type": "string", "minLength": 1},
            "time_format": {"type": "string", "minLength": 1},
            "severity_field": {"type": "string", "minLength": 1}
          },
          "allOf": [
            {"if": {"properties": {"type": {"const": "regex"}}}, "then": {"required": ["expression"]}},
            {"if": {"properties": {"type": {"const": "csv"}}}, "then": {"required": ["columns"]}}
          ],
          "additionalProperties": false
        },
        "payload": {
          "type": "object",
          "required": ["body_from", "field_mappings", "resource_attributes", "record_attributes"],
          "properties": {
            "body_from": {"type": "string", "minLength": 1},
            "field_mappings": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
            "resource_attributes": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}},
            "record_attributes": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
