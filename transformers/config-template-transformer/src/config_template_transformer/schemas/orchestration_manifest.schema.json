{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Copyright 2026 opamp.info; licensed under the Apache License, Version 2.0.",
  "title": "Configuration transformation orchestration manifest",
  "description": "Versioned JSON handoff containing generated fragments and parent include instructions.",
  "type": "object",
  "required": ["schema_version", "generated_at", "generator", "target", "source", "artifacts"],
  "properties": {
    "schema_version": {"const": "3.0", "description": "Manifest contract version with per-plugin detector provenance."},
    "generated_at": {"type": "string", "format": "date-time", "description": "UTC generation time."},
    "generator": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": ["tool", "version", "configuration_format", "include_strategy"],
      "properties": {
        "tool": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "configuration_format": {"type": "string", "minLength": 1},
        "include_strategy": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["detector_results_path", "sha256"],
      "properties": {
        "detector_results_path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["transform_name", "transform_version", "detector_name", "detector_version", "selection_status", "path", "sha256", "media_type", "plugin_count", "template", "include", "plugins"],
        "properties": {
          "transform_name": {"type": "string", "minLength": 1},
          "transform_version": {"type": "string", "minLength": 1},
          "detector_name": {"type": "string", "minLength": 1},
          "detector_version": {"type": "string"},
          "selection_status": {"type": "string", "enum": ["rendered", "detector_not_found", "detector_not_detected", "detector_errors"]},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "media_type": {"type": "string", "minLength": 1},
          "plugin_count": {"type": "integer", "minimum": 0},
          "plugins": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["plugin_id", "source_format", "human_link", "detector_link", "rule_name", "source_selector", "source_index", "properties", "configuration_sha256"],
              "properties": {
                "plugin_id": {"type": "string", "pattern": "^[a-z0-9._-]+-[0-9a-f]{12}$"},
                "source_format": {"type": "string", "minLength": 1},
                "human_link": {"type": "string", "minLength": 1},
                "detector_link": {"type": "string", "pattern": "^detector://"},
                "rule_name": {"type": "string", "minLength": 1},
                "source_selector": {"type": "string", "minLength": 1},
                "source_index": {"type": "integer", "minimum": 0},
                "properties": {"type": "object"},
                "configuration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              },
              "additionalProperties": false
            }
          },
          "template": {
            "type": "object",
            "required": ["name", "path", "version", "api_version", "engine", "sha256", "metadata_path", "metadata_api_version", "metadata_sha256", "target", "supports"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "api_version": {"type": "string", "minLength": 1},
              "engine": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "metadata_path": {"type": "string", "minLength": 1},
              "metadata_api_version": {"type": "string", "minLength": 1},
              "metadata_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "target": {
                "type": "object",
                "required": ["tool", "version_constraint"],
                "properties": {
                  "tool": {"type": "string", "minLength": 1},
                  "version_constraint": {"type": "string", "minLength": 1}
                },
                "additionalProperties": false
              },
              "supports": {
                "type": "object",
                "required": ["artifact_kind", "signals", "capabilities"],
                "properties": {
                  "artifact_kind": {"type": "string", "minLength": 1},
                  "signals": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                  "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "include": {
            "type": "object",
            "required": ["strategy", "path", "literal"],
            "properties": {
              "strategy": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1},
              "literal": {"const": true}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
