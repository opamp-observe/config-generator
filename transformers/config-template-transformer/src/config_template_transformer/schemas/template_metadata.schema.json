{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Copyright 2026 opamp.info; licensed under the Apache License, Version 2.0.",
  "title": "Observability configuration template metadata",
  "description": "Identifies a Jinja template, its context contract, capabilities, and compatible observability-tool versions.",
  "type": "object",
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {
      "const": "opamp.info/v1alpha1",
      "description": "Version of the template-metadata resource contract."
    },
    "kind": {
      "const": "ObservabilityTemplateMetadata",
      "description": "Resource kind understood by the template metadata loader."
    },
    "metadata": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$", "description": "Stable template identity."},
        "version": {"type": "string", "minLength": 1, "description": "Semantic template implementation version."}
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": ["engine", "template", "template_api_version", "target", "supports"],
      "properties": {
        "engine": {"const": "jinja2", "description": "Rendering engine required by this template."},
        "template": {"type": "string", "minLength": 1, "description": "Template path relative to the approved template root."},
        "template_api_version": {"type": "string", "minLength": 1, "description": "Version of the context contract consumed by the template."},
        "target": {
          "type": "object",
          "required": ["tool", "version_constraint"],
          "properties": {
            "tool": {"type": "string", "minLength": 1, "description": "Supported observability-tool adapter name."},
            "version_constraint": {"type": "string", "minLength": 1, "description": "PEP 440 compatible supported tool-version range."}
          },
          "additionalProperties": false
        },
        "supports": {
          "type": "object",
          "required": ["artifact_kind", "signals", "capabilities"],
          "properties": {
            "artifact_kind": {"type": "string", "minLength": 1, "description": "Stable kind of configuration fragment produced."},
            "signals": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1},
              "description": "Observability signals represented by the template."
            },
            "capabilities": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1},
              "description": "Stable feature identifiers supported by the template."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
