{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Copyright 2026 opamp.info; licensed under the Apache License, Version 2.0.",
  "title": "Semantic mapping stage manifest",
  "type": "object",
  "required": ["schema_version", "generated_at", "target", "source", "mappings", "artifacts"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "target": {
      "type": "object",
      "required": ["tool", "plugin_count"],
      "properties": {
        "tool": {"type": "string", "minLength": 1},
        "plugin_count": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["orchestration_manifest_path", "orchestration_manifest_sha256", "detector_results_path", "detector_results_sha256"],
      "properties": {
        "orchestration_manifest_path": {"type": "string", "minLength": 1},
        "orchestration_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "detector_results_path": {"type": "string", "minLength": 1},
        "detector_results_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["plugin_id", "mapping_name", "mapping_version", "mapping_path", "mapping_sha256", "semantic_conventions_version", "detector_link"],
        "properties": {
          "plugin_id": {"type": "string", "minLength": 1},
          "mapping_name": {"type": "string", "minLength": 1},
          "mapping_version": {"type": "string", "minLength": 1},
          "mapping_path": {"type": "string", "minLength": 1},
          "mapping_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "semantic_conventions_version": {"type": "string", "minLength": 1},
          "detector_link": {"type": "string", "pattern": "^detector://"}
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "media_type", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "media_type": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
