{
  "_comment": "Copyright 2026 opamp.info; licensed under the Apache License, Version 2.0.",
  "api_version": "opamp.info/v1alpha1",
  "kind": "ObservabilityAgentMapping",
  "metadata": {"name": "otelcol_contrib_0_163_nginx_1", "version": "1.0.0"},
  "spec": {
    "detector": {"name": "nginx_1", "version_constraint": ">=1,<2"},
    "agent": {"type": "otelcol-contrib", "minimum_version": "0.163.0"},
    "output": {
      "path": "generated/otelcol-contrib/nginx.yaml",
      "include_path": "generated/otelcol-contrib/nginx.yaml"
    },
    "render": {
      "engine": "jinja2",
      "template": "otelcol_contrib_0_163_nginx.yaml.j2",
      "metadata_file": "otelcol_contrib_0_163_nginx.metadata.yaml",
      "version": "1.0.0",
      "template_api_version": "1.0",
      "context_name": "plugins"
    },
    "rules": [
      {
        "name": "nginx_logs",
        "for_each": "$.queries.log_locations[*]",
        "path_from": "$.path_or_destination",
        "path_match": "(?i)(access|error)[^;]*\\.log$",
        "source_format": "nginx.auto",
        "values": {"kind": "filelog", "start_at": "end"}
      },
      {
        "name": "nginx_metrics",
        "for_each": "$.queries.metrics_outputs[*]",
        "fields_from": {"host": "$.endpoint_host", "port": "$.port"},
        "values": {
          "kind": "nginx",
          "status_path": "/status",
          "collection_interval": "10s"
        }
      }
    ]
  }
}
