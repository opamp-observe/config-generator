{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Copyright 2026 opamp.info; licensed under the Apache License, Version 2.0.",
  "title": "PostgreSQL 18 detector result",
  "description": "Validates one postgresql_18 result emitted by runner.py.",
  "type": "object",
  "required": [
    "detector_name",
    "detector_version",
    "product",
    "product_version",
    "release_status",
    "platform",
    "detected",
    "discovery_evidence",
    "queries",
    "errors"
  ],
  "properties": {
    "detector_name": {
      "const": "postgresql_18",
      "description": "Stable detector identifier."
    },
    "detector_version": {
      "const": "1.0.0",
      "description": "Version of the detector logic that produced this result."
    },
    "product": {
      "const": "PostgreSQL"
    },
    "product_version": {
      "const": "18"
    },
    "release_status": {
      "const": "stable"
    },
    "platform": {
      "type": "string",
      "enum": [
        "linux",
        "windows"
      ]
    },
    "detected": {
      "type": "boolean"
    },
    "discovery_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/discovery_evidence"
      }
    },
    "queries": {
      "type": "object",
      "properties": {
        "runtime": {
          "type": "array",
          "description": "Rows returned by the runtime osquery pack query.",
          "items": {
            "$ref": "#/$defs/osquery_row"
          }
        },
        "network_ports": {
          "type": "array",
          "description": "Rows returned by the network_ports osquery pack query.",
          "items": {
            "$ref": "#/$defs/osquery_row"
          }
        },
        "configuration_files": {
          "type": "array",
          "description": "Rows returned by the configuration_files osquery pack query.",
          "items": {
            "$ref": "#/$defs/osquery_row"
          }
        },
        "log_locations": {
          "type": "array",
          "description": "Rows returned by the log_locations osquery pack query.",
          "items": {
            "$ref": "#/$defs/osquery_row"
          }
        },
        "version_evidence": {
          "type": "array",
          "description": "Rows returned by the version_evidence osquery pack query.",
          "items": {
            "$ref": "#/$defs/osquery_row"
          }
        }
      },
      "additionalProperties": false
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "detected": {
            "const": true
          }
        },
        "required": [
          "detected"
        ]
      },
      "then": {
        "properties": {
          "queries": {
            "required": [
              "runtime",
              "network_ports",
              "configuration_files",
              "log_locations",
              "version_evidence"
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "osquery_row": {
      "type": "object",
      "description": "A flat osquery JSON row. osquery serializes column values as strings.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "discovery_evidence": {
      "type": "object",
      "required": [
        "query",
        "rows"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/osquery_row"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
